# For more information, please see the README.md
SUNO_COOKIE=
# Headless is supported, but CloakBrowser's own docs note some sites still detect it even with
# the C++ patches applied, so headed remains the recommended default.
BROWSER_HEADLESS=false
# MUST be region-qualified. Measured (docs/fingerprint-tools/verify-locale-header.mjs): a bare `en`
# yields `Accept-Language: en` and `navigator.languages ["en"]`, which no default Chrome install
# produces — an inconsistency against the browser's own Chrome identity. `en-GB` also matches the
# transport's accept-language in src/lib/SunoApi.ts; change both together or not at all.
BROWSER_LOCALE=en-GB
# IANA timezone, e.g. Europe/Amsterdam. Routed through a binary flag, not CDP emulation.
# Set this even without a proxy: unset means the browser inherits the host zone, and it is also the
# precondition for the WebRTC fix below.
BROWSER_TIMEZONE=Europe/Amsterdam
# http://user:pass@host:port or socks5://user:pass@host:port
# (socks5 additionally needs `npm i socks-proxy-agent`)
# With a proxy set, BROWSER_TIMEZONE is what enables geoip — which spoofs the WebRTC IP to the
# proxy's exit IP. Without it WebRTC keeps advertising the real connection while HTTP goes through
# the proxy, and the module logs a warning saying so.
# NOTE: the curl-cffi transport in src/lib/SunoApi.ts has no proxy option, so setting this alone
# makes one authenticated Suno session arrive from two different networks.
BROWSER_PROXY=
# `careful` (slower, more deliberate mouse and typing) or `default`. `careful` is the default here:
# this path only runs when a captcha is already required, so latency matters less than passing, and
# it is the only preset with idle-between-actions enabled.
BROWSER_HUMAN_PRESET=careful
# Pins the device fingerprint (canvas/WebGL/audio/font noise). CloakBrowser otherwise re-randomizes
# it on EVERY launch, so one Suno account would present a new device on every generation from the
# same IP — which is what Cloudflare answers by escalating to an interactive challenge every time.
# Any 5-digit value; keep it stable, and change it only to deliberately become a different machine.
BROWSER_FINGERPRINT_SEED=48213
# Keeps the browser profile between runs: the cookie-consent choice, the localStorage that stops Suno
# replaying its first-run tour, __cf_bm continuity, and a device with some history. ON BY DEFAULT even
# if this line is absent; set it to the literal `none` for a throwaway profile per run.
# One directory serves one account; concurrent use is prevented by the existing launch mutex.
# A brand-new directory is still a first visit — warm it once, by hand, with:
#   node --env-file=.env docs/fingerprint-tools/warm-profile.mjs
BROWSER_PROFILE_DIR=./input/browser-profile
# Optional CloakBrowser Pro key. Unset uses the free Chromium 146 build, which needs no login.
CLOAKBROWSER_LICENSE_KEY=
